# Copy to .env for Docker Compose or local runs. These are development placeholders.
# Change every password and the secret key before any shared deployment.

ENVIRONMENT=development
DEBUG=false
SECRET_KEY=dev-only-change-me
DATABASE_URL=sqlite:///./piae.db
REDIS_URL=redis://localhost:6379/0
INVESTIGATION_EAGER=true
AUTO_CREATE=true
SEED_ON_STARTUP=true
DEMO_MODE=false
DNS_ENABLED=true
RDAP_ENABLED=true
CT_ENABLED=true
RIPE_ENABLED=true
WAYBACK_ENABLED=true
PAGE_ENABLED=true
PROFILES_ENABLED=true

POSTGRES_PASSWORD=piae-dev-password
PIAE_APP_PASSWORD=piae-app-dev

ANALYST_EMAIL=analyst@piae.test
ANALYST_PASSWORD=changeme-dev-only
ANALYST_DISPLAY_NAME=analyst
ADMIN_EMAIL=admin@piae.test
ADMIN_PASSWORD=changeme-admin-dev-only

# Optional. Reports are still generated without it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_REFERER=http://localhost

# Optional graph projection. Leave blank to use NetworkX only.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

DNS_ENABLED=false
RDAP_ENABLED=false
CT_ENABLED=false
URLHAUS_ENABLED=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
